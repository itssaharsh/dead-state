# Any ONE of these is enough. More keys = more failover legs when a provider
# rate-limits mid-demo. They are tried in this order, and each provider also
# falls back across its own models.
GEMINI_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# Only needed for the asset step (Rodin). The three checks never call it.
HYPER3D_API_KEY=
